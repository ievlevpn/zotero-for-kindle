{
  // Shared settings for type-checking plugins against zk.d.ts. A plugin's own tsconfig.json
  // extends this one and adds its sources (see template/tsconfig.json).
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": ["types/zk.d.ts"]
}
