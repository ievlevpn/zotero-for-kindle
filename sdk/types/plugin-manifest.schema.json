{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ievlevpn/zotero-for-kindle/sdk/types/plugin-manifest.schema.json",
  "title": "Zotero for Kindle plugin manifest (plugin.json), API v0",
  "type": "object",
  "required": ["id", "name", "version", "api", "main", "permissions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "Lowercase letters, digits and dashes; also the plugin's folder name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": { "description": "What the user sees.", "type": "string", "minLength": 1, "maxLength": 40 },
    "version": {
      "description": "The plugin's version, semver (major.minor.patch).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "api": {
      "description": "The plugin API version it was written for. 0 is the current, unstable one.",
      "const": 0
    },
    "minApp": {
      "description": "The oldest app version it runs on.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "author": { "type": "string" },
    "description": { "description": "One or two sentences, shown with the permissions.", "type": "string" },
    "main": {
      "description": "The plugin's one JavaScript file (an ES module), in the plugin folder.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.js$"
    },
    "permissions": {
      "description": "What the plugin may do; shown to the user before it is turned on.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "enum": [
              "library:read",
              "annotations:read",
              "fulltext:read",
              "notes:read",
              "net:*",
              "zotero:create-items",
              "zotero:collections",
              "zotero:tags",
              "zotero:notes",
              "zotero:remove",
              "background"
            ]
          },
          {
            "description": "net:<host>, or net:*.<domain> for its subdomains. Not an address (a last label of digits or 0x…) and not zotero.org.",
            "type": "string",
            "pattern": "^net:(?!(.*\\.)?zotero\\.org$)(?!.*\\.([0-9]+|0x[0-9a-f]*)$)(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
          }
        ]
      }
    }
  }
}
